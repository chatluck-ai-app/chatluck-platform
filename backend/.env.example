# Chat Luck AI backend configuration template. Copy to .env and fill.
# Never commit a real .env. Never put any key in the Android app or web JS.

DATABASE_URL=sqlite+aiosqlite:///./chatluck.db
# Production (Neon/Render Postgres):
# DATABASE_URL=postgresql+asyncpg://user:password@host/chatluck?ssl=require

JWT_SECRET=change-me-to-a-long-random-string
ENVIRONMENT=development

# Free-tier provider keys (server-side only)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
